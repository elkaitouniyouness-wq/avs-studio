# === AI Video Automation Studio : configuration (aucun secret réel ici) ===

# Application
APP_SECRET_KEY=change-me-long-random-string
APP_ENCRYPTION_KEY=generate-with-python-cryptography-fernet
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong-password
PUBLIC_BASE_URL=https://studio.example.com
FRONTEND_ORIGIN=https://studio.example.com

# Base de données et file de tâches
# POSTGRES_PASSWORD (bas du fichier) doit être identique au mot de passe dans cette URL (avs:MOTDEPASSE@).
DATABASE_URL=postgresql+psycopg2://avs:avs@db:5432/avs
REDIS_URL=redis://redis:6379/0

# Stockage des médias (dossier local monté en volume)
MEDIA_DIR=/data/media

# IA de scripts (Anthropic)
ANTHROPIC_API_KEY=
SCRIPT_MODEL=claude-sonnet-5-5

# Voix : Google Cloud Text-to-Speech (clé API)
GOOGLE_TTS_API_KEY=

# Médias libres de droits (Pexels)
PEXELS_API_KEY=

# YouTube Data API v3 (OAuth 2.0, console Google Cloud)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://studio.example.com/api/youtube/callback

# Budgets (USD)
DEFAULT_MAX_BUDGET_PER_VIDEO=1.00
DEFAULT_DAILY_BUDGET=5.00

# Clé API YouTube Data (optionnelle, pour les signaux de tendance réels)
YOUTUBE_API_KEY=
COOKIE_SECURE=true
OPENAI_API_KEY=
INLINE_JOBS=false

# Production HTTPS (docker-compose.prod.yml)
DOMAIN=studio.example.com
POSTGRES_PASSWORD=avs

# Google Gemini (palier GRATUIT : scripts + voix) — clé sur aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (palier GRATUIT, secours texte si Gemini est saturé) — clé sur console.groq.com/keys
GROQ_API_KEY=

# Voix gratuite Edge TTS (sans clé, non officielle) utilisée en dernier recours. Mettre false pour la désactiver.
EDGE_TTS=true

# Modèles Gemini de secours (essayés si le principal atteint son quota gratuit)
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

COOKIE_SECURE=false
APP_SECRET_KEY=Zq8xT3mVb7LpR2nYc9HdKs4WjF6uEa1GoIe5Xt0B
APP_ENCRYPTION_KEY=
